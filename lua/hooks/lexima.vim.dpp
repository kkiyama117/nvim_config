-- lua_add {{{
vim.g["g:lexima_enable_basic_rules"] = 1
--}}}

-- lua_source {{{

-- |lexima-customization|
local add_rule = vim.fn["lexima#add_rule"]
add_rule({char="(",at='\\%#\\w', input="("})

-- latex
add_rule({char="$", input_after="$",filetype='latex'})
add_rule({char="$", at="\\%#\\$", leave=1, filetype='latex'})
add_rule({char="<BS>", at="\\$\\%#\\$", delete=1, filetype='latex'})
-- }}}

