" hook_add {{{
" Shared function for ddu.vim, vim-gin and ddu-source-git_*
"
" The Gin action chooser replacement (`a` in ginlog buffers) lives in
" after/ftplugin/gin-log.lua. It is sourced after gin's own
" ftplugin/gin-log.vim, so it deterministically wins over gin's
" `map a <Plug>(gin-action-choice)` (a BufReadCmd hook here would not:
" dpp hook_add runs at startup, before gin's plugin files are sourced).
lua << EOF
EOF
" }}}

" hook_source {{{
lua << EOF
EOF
" }}}

