-- lua_add {{{
-- rustaceanvim owns the rust-analyzer client (Option A): kakehashi no
-- longer bridges rust_analyzer (see deps/testing.toml + lua/vimrc/kakehashi_config.lua).
-- It is a pure filetype plugin: this lua_add runs at startup, and nothing
-- else happens until a rust file opens (ftplugin/rust.lua auto-attaches
-- via config.server.auto_attach).
--
-- Resolve binaries like after/lsp/kakehashi.lua does for kakehashi
-- children: exepath first, then the mise shims dir (a stale PATH from an
-- environment started before a tool upgrade would otherwise fall back to a
-- bare name and fail to spawn).
-- (Pattern from https://github.com/mrcjkb/rustaceanvim/blob/main/doc/mason.txt
-- — binary resolution in `server.cmd`, minus mason.)
local function resolve_binary(name)
  local resolved = vim.fn.exepath(name)
  if resolved ~= '' then
    return resolved
  end
  local mise_shims = vim.fs.joinpath(
    vim.env.HOME or '~',
    '.local',
    'share',
    'mise',
    'shims',
    name
  )
  if vim.fn.executable(mise_shims) == 1 then
    return mise_shims
  end
  return name
end

---@type rustaceanvim.Opts
vim.g.rustaceanvim = {
  server = {
    cmd = { resolve_binary('rust-analyzer') },
  },
  -- DAP adapter: no explicit `dap.adapter` — rustaceanvim's default
  -- detection (config/internal.lua) prefers codelldb (PATH, then
  -- mason-installed via mason-registry) and falls back to lldb-dap on
  -- PATH. An explicit adapter here would override that detection and
  -- block codelldb. codelldb is installed via mason (deps/lsp.toml);
  -- lldb-dap (/usr/bin/lldb-dap) remains the fallback.
}
-- }}}
