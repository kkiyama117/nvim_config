-- lua_add {{{
-- set the config of Nvim own, like `statusline`

-- }}}

-- lua_source {{{
-- To setup, see `https://github.com/rebelot/heirline.nvim/blob/master/cookbook.md`
local heirline = require("heirline")

-- Heirline components has nested structure like XML.
-- So we need to create component blocks, and merge them into `statusline`.
-- Each parts are defined in `hooks/heirline_components`
local components = require("hooks/heirline_components")
local colors = components.get_colors("catppuccin", vim.g["vimrc#colors"]).colors

-- Buildins
local conditions = require("heirline.conditions")
local utils = require("heirline.utils")

-- Custom one

local ViMode = components.ViMode
local FileName = components.FileName
local Ruler = components.Ruler

-- --------------------------------------------------------------------------
-- layout helpers
-- --------------------------------------------------------------------------
local Align = { provider = "%=" }
local Space = { provider = " " }

-- --------------------------------------------------------------------------
-- conditional statuslines (Lion's finesse style)
-- https://github.com/rebelot/heirline.nvim/blob/master/cookbook.md#lions-finesse
-- 1st level: match buftype/filetype/bufname (fallthrough = false)
-- 2nd level: pick active vs inactive child (fallthrough = false)
-- Skipped (plugins not installed): Snippets(ultisnips), Navic(nvim-navic),
-- DAPMessages(nvim-dap), LSPMessages(lsp-status), UltTest(ultest)
-- --------------------------------------------------------------------------
local StatusLines = {
  hl = function ()
    if conditions.is_active() then
      return "StatusLine"
    else
      return "StatusLineNC"
    end
  end,

  -- A classic: mode-colored backgrounds (cookbook: A classic)
  -- Statusline-global utility: any component can call `self:mode_color()`.
  static = {
    mode_colors_map = {
      n = "red",
      i = "green",
      v = "cyan",
      V = "cyan",
      ["\22"] = "cyan",
      c = "orange",
      s = "purple",
      S = "purple",
      ["\19"] = "purple",
      R = "orange",
      r = "orange",
      ["!"] = "red",
      t = "green",
    },
    mode_color = function (self)
      local mode = conditions.is_active() and vim.fn.mode() or "n"
      return self.mode_colors_map[mode:sub(1, 1)]
    end,
  },

  -- stop at the first branch whose buftype/filetype/bufname matches
  fallthrough = false,

  -- Special buffers: help, quickfix, nofile, prompt, git
  {
    condition = function ()
      return conditions.buffer_matches({
        buftype = { "nofile", "prompt", "help", "quickfix" },
        filetype = { "^git.*", "fugitive" }
      })
    end,
    fallthrough = false,
    {
      condition = conditions.is_active,
      components.FileType,
      Space,
      components.HelpFileName,
      Align
    },
    {
      components.FileType,
      Space,
      Align
    }
  },

  -- Terminal buffers
  {
    condition = function ()
      return conditions.buffer_matches({ buftype = { "terminal" } })
    end,
    hl = { bg = "dark_red" },
    fallthrough = false,
    {
      condition = conditions.is_active,
      components.ViMode,
      Space,
      components.FileType,
      Space,
      components.TerminalName,
      Align
    },
    {
      components.FileType,
      Space,
      components.TerminalName,
      Align
    }
  },

  -- Default: regular buffers
  {
    fallthrough = false,
    {
      condition = conditions.is_active,
      components.ViMode,
      Space,
      components.WorkDir,
      Space,
      components.Git,
      Space,
      components.LSP.LSPDiagnostics,
      Align,
      components.LSP.LSPActive,
      Space,
      components.Spell,
      Space,
      components.SearchCount,
      Space,
      components.MacroRec,
      Space,
      components.ShowCmd,
      Space,
      components.FileType,
      Space,
      components.FileSize,
      Space,
      components.FileLastModified,
      Space,
      components.FileEncoding,
      Space,
      components.FileFormat,
      Space,
      -- surround the Ruler with the mode color (Airline style)
      utils.surround({ "\u{E0B6}", "\u{E0B4}" }, function (self)
        return self:mode_color()
      end, { components.Ruler, hl = { fg = "black" } }),
      Space,
      components.ScrollBar
    },
    {
      components.FileType,
      Space,
      Align
    }
  }
}

-- --------------------------------------------------------------------------
-- winbar (conditional)
-- https://github.com/rebelot/heirline.nvim/blob/master/cookbook.md#winbar
-- --------------------------------------------------------------------------
local WinBars = {
  fallthrough = false,
  { -- A special winbar for terminals
    condition = function ()
      return conditions.buffer_matches({ buftype = { "terminal" } })
    end,
    utils.surround({ "\u{E0B6}", "\u{E0B4}" }, "dark_red", {
      components.FileType,
      Space,
      components.TerminalName
    })
  },
  { -- An inactive winbar for regular files
    condition = function ()
      return not conditions.is_active()
    end,
    utils.surround(
      { "\u{E0B6}", "\u{E0B4}" }, "bright_bg",
      {
        hl = { fg = "gray", force = true },
        components.FileName,
        Space,
        components.CloseButton
      }
    )
  },
  -- A winbar for regular files
  utils.surround({ "\u{E0B6}", "\u{E0B4}" }, "bright_bg", { components.FileName, Space, components.CloseButton })
}

local TabLine = components.TabLine
local StatusColumn = nil

require('heirline').setup({
  statusline = StatusLines,
  winbar = WinBars,
  tabline = TabLine,
  statuscolumn = StatusColumn,
  opts = {
    colors = colors,
    -- if the callback returns true, the winbar will be disabled for that window
    disable_winbar_cb = function (args)
      return conditions.buffer_matches({
        buftype = { "nofile", "prompt", "help", "quickfix" },
        filetype = { "^git.*", "fugitive", "Trouble", "dashboard" }
      }, args.buf)
    end
  }
})

-- TablinePicker keymap (cookbook: TablinePicker)
-- Shows letter labels on the tabline; press the label key to jump to that buffer.
vim.keymap.set("n", "gbp", function ()
  local tabline = require("heirline").tabline
  local buflist = tabline._buflist[1]
  buflist._picker_labels = {}
  buflist._show_picker = true
  vim.cmd.redrawtabline()
  local char = vim.fn.getcharstr()
  local bufnr = buflist._picker_labels[char]
  if bufnr then
    vim.api.nvim_win_set_buf(0, bufnr)
  end
  buflist._show_picker = false
  vim.cmd.redrawtabline()
end)

-- Don't list buffers that are meant to be wiped/deleted (cookbook: Hello Tabline)
vim.api.nvim_create_autocmd("FileType", {
  callback = function ()
    if vim.tbl_contains({ "wipe", "delete" }, vim.bo.bufhidden) then
      vim.bo.buflisted = false
    end
  end
})

-- Theming (cookbook): re-evaluate colors when the colorscheme changes.
-- The colorscheme hooks (catppuccin/tokyonight/nightfox) refresh
-- `vim.g["vimrc#colors"]` first (registered at boot, before this hook).
vim.api.nvim_create_autocmd("ColorScheme", {
  callback = function ()
    utils.on_colorscheme(components.get_colors(vim.g.colors_name, vim.g["vimrc#colors"]).colors)
  end
})
-- }}}

