-- lua_source {{{
require('nightfox').setup({
  options = {
    compile_path = vim.fn.expand(vim.fs.joinpath(vim.env.NVIM_CACHE_HOME, 'nightfox')),
    transparent = true
    --dim_inactive = true,
  }
})

-- vim.cmd([[colorscheme nightfox]])

local palettes = require('nightfox.palette')
vim.g["vimrc#colors"] = palettes
vim.g["vimrc#color_bg"] = palettes.load(vim.g.nightfox_style or "nightfox").bg1

-- Refresh the palette when the colorscheme changes at runtime
vim.api.nvim_create_autocmd("ColorScheme", {
    callback = function()
        if vim.g.colors_name and vim.g.colors_name:match("nightfox") then
            local palettes = require('nightfox.palette')
            vim.g["vimrc#colors"] = palettes
            vim.g["vimrc#color_bg"] = palettes.load(vim.g.nightfox_style or "nightfox").bg1
        end
    end,
})
-- }}}

